%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "primaryColor": "#F7F3EA", "primaryTextColor": "#1F1A14", "primaryBorderColor": "#C9BFA8", "lineColor": "#6F6558", "secondaryColor": "#F7F3EA", "tertiaryColor": "#F3F0E8"}}}%%
flowchart TD
  subgraph PROD["2. Produit et attente workflow"]
    direction TD
    P0["<span style='font-size:10px'>Cloud Run Service</span><br/>Créer le produit (admin)"]
    P0 --> P1["Créer <i>produit</i> (via <i>taxonomie_produit</i>)"]
    P1 --> P2["Start le workflow cycle de vie produit"]
    P2 --> PQ["Task queue Temporal<br/><i>product-lifecycle</i>"]
    PQ -- "poll worker" --> P3["<span style='font-size:10px'>Cloud Run Worker Pool</span><br/>Workflow produit démarré"]
    P3 --> P4["Charger le produit depuis la base"]
    P4 -- "en attente" --> P5["Workflow produit suspendu<br/>Attend les signaux de prérequis"]
  end

  subgraph TECH_UPLOAD["3. Déposer les sources techniques"]
    direction RL
    subgraph TECH_START["Lancement de l'analyse"]
      direction TD
      T3["<span style='font-size:10px'>Cloud Run Service</span><br/>Lancer l'ingestion (admin)"]
      T3 --> T4["Créer <i>document_ingestion_run</i><br/>EN_COURS / UPLOAD"]
      T4 --> T4B["Mettre <i>document_collection</i><br/>et <i>document_source</i> à EN_COURS"]
      T4B --> T4S["Notifier le workflow produit"]
      T4S --> T4C["Start le workflow d'analyse technique"]
    end

    subgraph TECH_SOURCES["Upload et sources"]
      direction TD
      T0["<span style='font-size:10px'>Cloud Run Service</span><br/>Upload les PDFs techniques (admin)"]
      T0 --> TGCS["Stocker chaque PDF technique dans GCS"]
      TGCS --> T1["Créer <i>document_collection</i>"]
      T1 --> T2["Créer les <i>document_source</i>"]
    end
  end

  %% Contrainte de layout invisible: garde les deux colonnes du point 3 alignées.
  T2 ~~~ P5
  T4C --> PQ
  T4S -- "signal Temporal<br/><i>TechnicalSourcesUploaded</i>" --> P5

  subgraph ANALYSIS_STYLE_ROW[" "]
    direction LR
    subgraph TECH_WF["4. Analyse du dossier technique"]
      direction TD
      PQ -- "poll worker technique" --> W0["Workflow d'analyse technique"]
      W0 --> T6["Charger le contexte d'ingestion"]
      T6 --> T6B["Mettre <i>document_ingestion_run</i><br/>à EN_COURS / DOCUMENT_CLASSIFICATION"]
      T6B --> T7["Classer chaque PDF technique"]
      T7 --> T7A["Appeler Document AI classifier<br/>pour chaque PDF"]
      T7A --> T8P["Persister les résultats de classification"]
      T8P --> T8["Mettre à jour <i>document_source</i><br/>type de fichier, score et métadonnées (GCP classifier)"]
      T8 -- "type non routable<br/>ou confiance &lt; 0.90" --> T8C["Créer les <i>technical_review_case</i><br/>Mettre <i>document_ingestion_run</i><br/>à A_VALIDER / HUMAN_REVIEW<br/>et <i>document_collection</i> à A_VALIDER"]
      T8 -- "type routable<br/>et confiance ≥ 0.90" --> T8F["Mettre <i>document_ingestion_run</i><br/>à EN_COURS / FACT_EXTRACTION"]
      T8C -. "note" .- T8N["Note démo<br/><i>TECHNICAL_SHEET</i> &lt; 0.90 est possible,<br/>mais peu fiable à provoquer.<br/>Souvent le classifier répond plutôt<br/><i>TECHNICAL_SHEET</i> très confiant<br/>ou <i>MIXED/OUT_OF_SCOPE</i> très confiant."]
      T8C --> T8R["Retourner <i>review_case_count</i>"]
      T8F --> T8R
      T8R --> T8B{"review_case_count > 0 ?"}
      T8B -- "Oui" --> T8E["Workflow suspendu<br/>Attend <i>review_case_resolved</i>"]
      T8E --> T8U["Décider sur le blocage<br/>Confirmer, corriger ou remplacer (admin)"]
      T8U --> T8U1["Appliquer la décision classification"]
      T8U1 --> T8U2["Mettre <i>technical_review_case</i><br/>à APPROUVE / CORRIGE<br/>ou DOCUMENT_A_REMPLACER<br/>et corriger <i>document_source</i> si routable"]
      T8U2 --> T8U3["Si dernier blocage : remettre<br/><i>document_ingestion_run</i><br/>à EN_COURS / FACT_EXTRACTION<br/>et <i>document_collection</i> à EN_COURS"]
      T8U3 -- "signal Temporal<br/><i>ReviewCaseResolved</i>" --> T8S{"open_review_case_count = 0 ?"}
      T8S -- "Non" --> T8E
      T8S -- "Oui" --> T8H["Recharger les classifications<br/>corrigées depuis la base"]
      T8H --> T12["Extraire les faits techniques"]
      T8B -- "Non" --> T12
      T12 --> T12A["Appeler Document AI Custom Extractor<br/>selon le type de fichier"]
      T12A --> T13["Persister les facts candidats"]
      T13 --> T13A["Créer une ligne <i>technical_fact_candidate</i><br/>pour chaque candidat extrait"]
      T13A --> T13B["Enregistrer extraction_steps_json<br/>et mettre <i>document_ingestion_run</i><br/>à EN_COURS / DETERMINISTIC_VALIDATION"]
      T13B --> T14["Contrôler les facts candidats"]
      T14 --> T14A["Charger le profil de prérequis fiche produit<br/><i>product_sheet_requirement_profile</i>"]
      T14A --> T14B["Contrôler champs requis,<br/>confiance et bornes réalistes"]
      T14B --> T14C["Retourner facts promouvables<br/>et blocages à revoir"]
      T14C --> T18["Promouvoir les faits techniques"]
      T18 --> T18A["Recréer les <i>technical_fact_candidate</i><br/>avec statut de validation"]
      T18A --> T18B["Créer les <i>technical_fact</i><br/>validés SYSTEM"]
      T18B --> T18C["Créer les <i>technical_review_case</i><br/>A_TRAITER si blocage readiness"]
      T18C --> T18D["Mettre <i>document_ingestion_run</i><br/>à A_VALIDER / HUMAN_REVIEW<br/>ou TERMINE / DONE"]
      T18D --> T18E["Mettre <i>document_collection</i><br/>à A_VALIDER ou TERMINE<br/>et <i>document_source</i> à TERMINE"]
      T18E --> T15{"review_case_count > 0 ?"}
      T15 -- "Oui" --> T16["Workflow suspendu<br/>Attend <i>review_case_resolved</i>"]
      T16 --> T17["Décider sur le fact bloquant (admin)"]
      T17 --> T17A["Mettre <i>technical_review_case</i><br/>à APPROUVE / CORRIGE / REJETE<br/>ou DOCUMENT_A_REMPLACER"]
      T17A --> T17B["Créer <i>technical_fact</i> HUMAN<br/>si valeur approuvée ou corrigée"]
      T17B --> T17C["Si dernier blocage : mettre <i>document_ingestion_run</i><br/>à TERMINE / DONE<br/>et <i>document_collection</i> à TERMINE"]
      T17C -- "signal Temporal<br/><i>ReviewCaseResolved</i>" --> T17D{"open_review_case_count = 0 ?"}
      T17D -- "Non" --> T16
      T17D -- "Oui" --> T17E["Finaliser la revue technique"]
      T17E --> T17F["Vérifier que tous les facts requis<br/>sont présents"]
      T17F --> T19["Faits techniques prêts<br/>TECHNICAL_FACTS_READY"]
      T15 -- "Non" --> T19
      T19 --> T20["Notifier facts techniques prêts"]
      T20 -- "signal Temporal<br/><i>TechnicalFactsReady</i>" --> P5
    end

    subgraph SG["1. Guide de style"]
      direction TD
      SG0["Importer le PDF du guide (admin)"]
      SG0 --> SG0A["Stocker le PDF du guide dans GCS"]
      SG0A --> SG0B["Créer <i>document_collection</i><br/>et <i>document_source</i>"]
      SG0B --> SG0C["Lancer l'ingestion du guide (admin)"]
      SG0C --> SG0D["Créer <i>document_ingestion_run</i><br/>EN_COURS / UPLOAD"]
      SG0D --> SG1["Workflow d'analyse du guide"]
      SG1 --> SG2["Analyser le layout du guide"]
      SG2 --> SG2A["Appeler Document AI Layout Parser"]
      SG2A --> SG2B["Enregistrer parser, version<br/>et latence dans <i>document_ingestion_run</i>"]
      SG2B --> SG3["Générer le pack candidat"]
      SG3 --> SG3A["Mettre <i>document_ingestion_run</i><br/>à EN_COURS / LLM_DRAFT_PACK"]
      SG3A --> SG3B["Charger taxonomie<br/>et prompt registry"]
      SG3B --> SG3C["Appeler LiteLLM / Vertex AI<br/>avec structured output"]
      SG3C --> SG3D["Contrôler le JSON,<br/>les preuves et la taxonomie"]
      SG3D --> SG3E["Créer <i>style_pack</i> BROUILLON<br/><i>style_rule</i> A_VALIDER<br/><i>document_ingestion_run</i> A_VALIDER / HUMAN_REVIEW"]
      SG3E --> SG7["Attendre la revue éditoriale"]
      SG7 --> SG8{"Décision sur le pack"}
      SG8 -- "Activer" --> SG9["Finaliser l'activation du pack"]
      SG9 --> SG9A["Mettre <i>style_pack</i> à ACTIF<br/><i>document_ingestion_run</i><br/>à TERMINE / DONE"]
      SG9A --> SG9B["Notifier les workflows produit<br/><i>style_pack_activated</i>"]
      SG9B -- "signal Temporal<br/><i>StylePackActivated</i>" --> P5
      SG9B --> SG11["Pack de style<br/>ACTIF"]
      SG8 -- "Rejeter" --> SG10["Finaliser le rejet du pack"]
      SG10 --> SG10A["Mettre <i>style_pack</i> à ARCHIVE<br/><i>document_ingestion_run</i><br/>à ANNULE / HUMAN_REVIEW"]
    end

    %% Contrainte de layout invisible: garde le guide de style à droite de l'analyse technique.
    W0 ~~~ SG0
  end

  subgraph COMM["5. Signaux commerciaux de démo"]
    direction TD
    C0["Précharger ventes et retours clients (admin)"]
    C0 --> C1["Seed via migration"]
    C1 --> C2["Snapshot commercial disponible"]
  end

  subgraph READY["6. Contexte prêt pour génération"]
    direction TD
    P5 --> R0["Vérifier les prérequis du contexte<br/><span style='font-size:10px'>activity appelée par ProductLifecycleWorkflow</span>"]
    R0 --> R1["Vérifier le produit"]
    R1 --> R2["Vérifier le pack de style<br/>ACTIF"]
    R2 --> R3["Choisir le snapshot commercial"]
    C2 -. "lu en base" .-> R3
    C2 -. "option futur<br/>signal Temporal<br/><i>CommercialSnapshotAvailable</i>" .-> P5
    R3 --> R4["Charger les faits techniques validés"]
    R4 --> R5{"Contexte complet ?"}
    R5 -- "Non" --> R6["Attendre l'élément manquant"]
    R6 --> R0
    R5 -- "Oui" --> R7["Créer <i>product_context_snapshot</i><br/><span style='font-size:10px'>écriture idempotente</span>"]
    R7 --> R8["Contexte prêt"]
    R8 --> G0["Générer la fiche produit (admin)"]
    G0 --> G1["Créer <i>product_sheet_generation</i><br/>EN_COURS"]
    G1 --> G2["Workflow génération fiche produit"]
    G2 --> G3["Générer la fiche candidate"]
    G3 --> G3A["Charger <i>product_context_snapshot</i>"]
    G3A --> G3B["Charger le prompt registry<br/>product_sheet_generate / v1"]
    G3B --> G3C["Appeler LiteLLM / Vertex AI<br/>avec structured output"]
    G3C --> G3D["Contrôler la sortie structurée<br/>et les claims interdits"]
    G3D --> G4["Persister le résultat de génération"]
    G4 --> G4A["Mettre <i>product_sheet_generation</i><br/>à TERMINE ou A_VALIDER"]
    G4A --> G8["Afficher la fiche produit<br/>dans l'admin"]
  end

  classDef workflow fill:#EAF4F2,stroke:#0F766E,stroke-width:2px,color:#134E4A;
  classDef activity fill:#FEE2E2,stroke:#B91C1C,stroke-width:1.5px,color:#7F1D1D;
  classDef api fill:#DBEAFE,stroke:#1D4ED8,stroke-width:1.5px,color:#1E3A8A;
  classDef wait fill:#F4F1EA,stroke:#756B5D,stroke-width:1.5px,color:#2D241C;
  classDef storage fill:#F7F3EA,stroke:#B8AA94,stroke-width:1.5px,color:#3A3026;
  classDef decision fill:#FEF3C7,stroke:#B45309,stroke-width:1.5px,color:#7C2D12;
  classDef note fill:#FFF7ED,stroke:#EA580C,stroke-width:1.2px,color:#7C2D12;

  class SG1,P3,W0,G2 workflow;
  class SG2,SG3,SG9,SG9B,SG10,P4,T6,T7,T8P,T8H,T12,T13,T14,T17E,T18,T20,R0,R7,G3,G4 activity;
  class SG0,SG0C,P0,T0,T3,T4S,T4C,T8U,T17,C0,G0,G8 api;
  class SG7,PQ,P5,T8E,T16,R6 wait;
  class C2,SG0A,SG0B,SG0D,SG2B,SG3A,SG3E,SG9A,SG10A,P1,TGCS,T1,T2,T4,T4B,T6B,T8,T8C,T8F,T8U1,T8U2,T8U3,T13A,T13B,T14A,T17A,T17B,T17C,T17F,T18A,T18B,T18C,T18D,T18E,R1,R2,R3,R4,G1,G3A,G4A storage;
  class SG8,T8B,T8S,T15,T17D,R5 decision;
  class T8N note;
  style ANALYSIS_STYLE_ROW fill:transparent,stroke:transparent,color:transparent
