// 0.90 pour dimensions/matière, car une erreur crée une fiche fausse.
// 0.85 pour SKU/nom, car c’est important mais souvent plus facile à détecter et à recouper.
// 0.80 pour finition, capacité et champs conditionnels de notice.
// 0.70 seulement pour détecter un conflit crédible ou garder un optionnel, pas pour promouvoir un champ
// control_type=NUMBER ne transforme pas la valeur source en nombre : il sert seulement au contrôle déterministe
// des bornes pour les profils où cette lecture numérique a du sens.

{
  "id": "00000000-0000-0000-0000-000000000201",
  "is_active": true,
  "created_at": "2026-04-27T08:30:00",
  "updated_at": "2026-04-27T08:30:00",
  "famille_code": "mobilier_jardin",
  "sous_famille_code": "table_repas_exterieur",
  "requirements_json": {
    "defaults": {
      "conflict_confidence_threshold": 0.7
    },
    "requirements": [
      {
        // le SKU est obligatoire. Si aucun candidat sku n’est extrait, on bloque la génération avec un review case.
        "level": "REQUIRED", 

        // on regarde les candidats extraits dont le label est exactement sku
        "field_name": "sku",

        // on veut une seule valeur finale promue pour ce champ. Pas plusieurs SKU.
        "cardinality": "SINGLE",

        // un candidat sku doit avoir au moins 85 % de confiance Document AI.
        // En dessous, il part en review case LOW_CONFIDENCE.
        "min_confidence": 0.85,

        // si deux valeurs différentes et crédibles apparaissent, on bloque au lieu de choisir arbitrairement.
        //   { "value": "220 cm", "confidence": 0.96 },
        //   { "value": "240 cm", "confidence": 0.85 }
        "conflict_policy": "BLOCK_ON_CREDIBLE_CONFLICT",

        //  si plusieurs PDFs donnent un SKU valide, on préfère dans cet ordre :
        // 1) Fiche technique produit
        // 2) Fiche matière
        // 3) Notice de montage
        "source_priority": [
          "TECHNICAL_SHEET",
          "MATERIAL_SPECIFICATION",
          "ASSEMBLY_NOTICE"
        ],

        // si plusieurs candidats SKU sont extraits, le backend essaie de choisir 
        // la meilleure valeur canonique au lieu de tout garder.
        // une valeur canonique est la valeur propre que le backend garde après avoir comparé plusieurs extractions possibles.
        "selection_policy": "CANONICAL_SINGLE",

        // sert à éviter de bloquer pour du bruit faible.
        //   { "value": "AX-TB-RIV-220", "confidence": 0.94 },
        //   { "value": "AX-TB-RIV-22O", "confidence": 0.41 }
        // Si une autre valeur différente a un score inférieur à 70 %, on la considère trop faible pour bloquer
        "conflict_confidence_threshold": 0.7
      },
      {
        "level": "REQUIRED",
        "field_name": "product_name",
        "cardinality": "SINGLE",
        "min_confidence": 0.85,
        "conflict_policy": "BLOCK_ON_CREDIBLE_CONFLICT",
        "selection_policy": "CANONICAL_SINGLE",
        "conflict_confidence_threshold": 0.7
