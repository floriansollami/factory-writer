# L'URL de connexion est requise car supprimée du code source
DB__URL=postgresql+psycopg://postgres:postgres_local_secret@localhost:5432/factory_writer

# Variables GCP requises pour un environnement réellement exécutable
# GCP__PROJECT_ID=votre-projet-gcp
# GCP__DOCUMENT_AI_PROCESSOR_ID=votre-processor-id-document-ai
# Recommandé pour le POC style guide: version Gemini Layout Parser avec chunking contextuel.
# GCP__DOCUMENT_AI_PROCESSOR_VERSION=pretrained-layout-parser-v1.5-2025-08-25
# GCP__STYLE_GUIDE_BUCKET_NAME=votre-bucket-style-guide

# Variables GCP avec fallback non sensible
# GCP__LOCATION=global
# GCP__DOCUMENT_AI_LOCATION=eu

# LiteLLM / Vertex AI pour l'extraction structuree du guide de style.
# Le modele, la temperature, max_tokens et response_format sont portes par le manifest du prompt.
LLM__STYLE_GUIDE_TIMEOUT_SECONDS=90
LLM__STYLE_GUIDE_PROMPT_NAME=style_guide_extract_rules
LLM__STYLE_GUIDE_PROMPT_VERSION=v1

# Configuration POC: Temporal Cloud (Authentification par API Key)
TEMPORAL__ADDRESS=factory-writer-poc.waxwe.tmprl.cloud:7233
TEMPORAL__NAMESPACE=factory-writer-poc.waxwe
TEMPORAL__API_KEY=votre_cle_api_temporelle_ici
TEMPORAL__WORKER_ROLE=style-guide-ingestion
TEMPORAL__DEPLOYMENT_NAME=factory-writer
