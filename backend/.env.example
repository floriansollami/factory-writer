# L'URL de connexion est requise car supprimée du code source
DB__URL=postgresql+psycopg://postgres:postgres_local_secret@localhost:5432/factory_writer

# Variables GCP requises pour un environnement réellement exécutable
# GCP__PROJECT_ID=votre-projet-gcp
# GCP__DOCUMENT_AI_PROCESSOR_ID=votre-processor-id-document-ai
# Recommandé pour le POC style guide: version rapide du Layout Parser, powered by Gemini 3 Flash.
# GCP__DOCUMENT_AI_PROCESSOR_VERSION=pretrained-layout-parser-v1.6-2026-01-13
# GCP__STYLE_GUIDE_BUCKET_NAME=votre-bucket-style-guide
# Dossiers techniques: classifier puis routage vers 3 custom extractors foundation model.
# GCP__DOCUMENT_AI_CLASSIFIER_PROCESSOR_ID=votre-processor-id-classifier
# GCP__DOCUMENT_AI_CLASSIFIER_PROCESSOR_VERSION=votre-version-classifier
# GCP__DOCUMENT_AI_OCR_PROCESSOR_ID=votre-processor-id-ocr-optionnel
# GCP__DOCUMENT_AI_OCR_PROCESSOR_VERSION=pretrained-ocr-v2.1-2024-08-07
# GCP__DOCUMENT_AI_TECHNICAL_SHEET_EXTRACTOR_PROCESSOR_ID=51d79fcf170d4db5
# GCP__DOCUMENT_AI_TECHNICAL_SHEET_EXTRACTOR_PROCESSOR_VERSION=pretrained-foundation-model-v1.5-pro-2025-06-20
# GCP__DOCUMENT_AI_MATERIAL_SPECIFICATION_EXTRACTOR_PROCESSOR_ID=6a06ee761cf984a5
